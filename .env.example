# ==============================================================================
# Modo de Operação:
# - "test"   -> Usa MySQL local + armazenamento em pasta local (storage_local/)
# - "deploy" -> Usa PostgreSQL (Supabase) + Supabase Storage (S3 via boto3)
# ==============================================================================
APP_ENV=test

# Django Core
SECRET_KEY=altere-para-uma-chave-forte-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Configurações do Modo TESTE (APP_ENV=test)
# Por padrão usa SQLite3 (db.sqlite3) para funcionar sem servidor de banco ativo.
# Caso queira usar MySQL local, altere TEST_DB_ENGINE para django.db.backends.mysql
# ------------------------------------------------------------------------------
TEST_DB_ENGINE=django.db.backends.sqlite3
SQLITE_DB_NAME=db.sqlite3

MYSQL_DB_NAME=epsl_test
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306

LOCAL_STORAGE_ROOT=/media/HDZAO/EPSL/storage_local
LOCAL_MEDIA_BASE_URL=http://localhost:8000/media

# ------------------------------------------------------------------------------
# Configurações do Modo DEPLOY / Produção no Coolify (APP_ENV=deploy)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua-senha-postgres
DB_HOST=localhost
DB_PORT=5432

# Supabase Storage (via protocolo S3 / boto3)
SUPABASE_URL=https://supabase.seudominio.com.br
SUPABASE_PUBLIC_STORAGE_URL=https://supabase.seudominio.com.br/storage/v1/object/public
SUPABASE_S3_ENDPOINT_URL=https://supabase.seudominio.com.br/storage/v1/s3
SUPABASE_S3_REGION_NAME=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=sua-access-key-s3
SUPABASE_S3_SECRET_ACCESS_KEY=sua-secret-key-s3
SUPABASE_STORAGE_BUCKET=diarios-oficiais
SUPABASE_INPUT_PREFIX=novos_diarios/
SUPABASE_PROCESSED_PREFIX=diarios_processados/

# ------------------------------------------------------------------------------
# Google Gemini API & Token para Webhook (n8n -> Django)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sua-chave-api-gemini
GEMINI_MODEL=gemini-2.5-flash
PIPELINE_TRIGGER_TOKEN=token-secreto-webhook-n8n
